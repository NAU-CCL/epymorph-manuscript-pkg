# OS
.DS_Store
Thumbs.db

# Environment / secrets
.env
*.key

# Editor
.vscode/
.idea/

# Assistant instructions and planning documents: local to the maintainer, not part of
# the reproducible artifact. The conventions a contributor needs are in the READMEs and
# in analysis/src/manuscript_analysis/demos/ADDING-FIGURES.md.
CLAUDE.md
MIGRATION_PLAN.md
*-plan-v*.md

# Word copies for collaborators: a dated snapshot to share, not something to version.
# Rebuilt by scripts/build-docx.sh.
results/manuscript-docx/

# Demo run outputs: ~1 GB of ensembles, regenerated by scripts/run-demos.sh or
# fetched from the archive. See results/demos/README.md.
results/demos/runs/

# Per-panel figures the notebooks save while you run them. Exploratory, not deliverables:
# the manuscript's figures are results/figures/, composed by the exporter.
results/demos/notebook/*
!results/demos/notebook/.gitkeep
